# ---------------------------------------------------------------------------
# CourseMate 环境变量示例
# 用法：复制本文件为 .env，再填入你自己的值。
# 注意：.env 已被 .gitignore 忽略，绝不要把真实密钥提交到仓库。
# API与聊天模型也可直接在「模型设置」页面配置并保存，无需编辑本文件。
# 页面保存的模型设置优先于环境变量和.env；下面的存储/向量等高级项仍由环境配置控制。
# ---------------------------------------------------------------------------

# ---- 大模型（OpenAI 兼容接口）----
# 供应商标识，仅用于日志与界面展示；实际调用只看下面三项
LLM_PROVIDER=deepseek
# 在供应商控制台申请，形如 sk-xxxxxxxx
LLM_API_KEY=replace_with_your_api_key
# DeepSeek: https://api.deepseek.com
# 通义千问(DashScope 兼容模式): https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.deepseek.com
# 必须以你账号"当前可用模型列表"为准，不要照抄；名称写错会返回 404
LLM_MODEL=replace_with_available_model_name

# 单次请求超时（秒）与重试次数
LLM_TIMEOUT=60
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.2

# ---- Embedding ----
# local: 本地 sentence-transformers（推荐，无需额外 Key，首次需下载模型约 100MB）
# openai: 走 OpenAI 兼容的 /embeddings 接口（需云端 Key，速度快但按量计费）
# hash: 离线降级（仅用于跑通链路，检索质量差，正式演示不要用）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 仅 EMBEDDING_PROVIDER=openai 时需要
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIM=512
# 模型已下载后设为 true：只读本地缓存不联网，启动更快、演示更稳
EMBEDDING_OFFLINE=false

# 国内网络下载向量模型慢/失败时启用镜像（可选）
HF_ENDPOINT=https://hf-mirror.com

# ---- 存储路径（相对路径按项目根目录解析）----
DB_PATH=data/coursemate.db
CHROMA_PATH=data/chroma
UPLOAD_DIR=data/uploads

# ---- 上传与分块 ----
MAX_UPLOAD_MB=50
# 中文按约 600 字切分、重叠 100 字
CHUNK_SIZE=600
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=4
# 问答时低于该相似度的片段不算依据，直接拒答（阶段 B 实测：资料内 0.5+，资料外 0.27）
QA_MIN_SCORE=0.35
# 每次问答最多送几条片段给模型
QA_TOP_K=4

# ---- 运行 ----
LOG_LEVEL=INFO
# 本地完整版保持 false；公开体验入口自动启用。
COURSEMATE_PUBLIC_DEMO=false
